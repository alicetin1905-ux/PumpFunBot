# Kopieer naar .env (staat in .gitignore). Alles is optioneel.
# Feed: solana (standaard, gratis, rechtstreeks van de blockchain) of pumpportal (trades vereisen een betaalde key)
FEED=solana
# Solana websocket-RPC. De publieke werkt soms niet onder druk; een gratis Helius/QuickNode-URL is stabieler:
# RPC_WSS=wss://mainnet.helius-rpc.com/?api-key=JOUW_KEY
# Alleen voor FEED=pumpportal:
# PUMPPORTAL_API_KEY=
# Dashboard op je iPhone/andere apparaten (zie README): luister op alle netwerkkaarten + verplicht wachtwoord.
# Zonder DASH_TOKEN blijft het dashboard alleen op deze Mac bereikbaar, ook als HOST gezet is.
# HOST=0.0.0.0
# DASH_TOKEN=kies-een-lang-willekeurig-wachtwoord
# Wallets volgen (alleen lezen/loggen): komma-gescheiden, optioneel met naam. De bot legt vast wanneer ze een gevolgd token kopen/verkopen.
# WATCH_WALLETS=jaap=<adres1>,<adres2>
